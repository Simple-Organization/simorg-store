{
  "name": "simorg-store",
  "version": "1.0.0-next.3",
  "author": "Simple Organization",
  "scripts": {
    "benchmark": "tsx tests/benchmark.ts",
    "build": "tsc && rollup -c && tsx esbuild.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepack": "bun run build",
    "test": "playwright test"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@playwright/test": "^1.47.1",
    "@types/benchmark": "^2.1.5",
    "@types/bun": "^1.2.10",
    "benchmark": "^2.1.4",
    "esbuild": "^0.23.1",
    "esbuild-utils": "1.0.0-next.9",
    "prettier": "^3.3.3",
    "rollup": "^4.21.3",
    "rollup-plugin-dts": "^6.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "preact/index.d.ts",
    "preact/index.js"
